config ST3215_SERVO
    bool "Waveshare ST3215 Serial Bus Servo driver"
    default y
    depends on DT_HAS_WAVESHARE_ST3215_ENABLED
    depends on UART_ASYNC_API
    select DMA
    help
      Enable the Waveshare ST3215 servo driver.
      Uses UART async API with DMA for efficient half-duplex communication.
