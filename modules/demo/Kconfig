menuconfig MAVWRAP
	bool "MAVLink Wrapper"
	help
	  Enable MAVLink communication wrapper with support for
	  multiple transport types (UART, UDP network).

if MAVWRAP

choice MAVWRAP_DIALECT
	prompt "MAVLink Dialect"
	default MAVWRAP_DIALECT_COMMON
	help
	  Select the MAVLink message dialect to use.
	  The dialect determines which message set is available.

config MAVWRAP_DIALECT_COMMON
	bool "common"
	help
	  MAVLink common dialect. Includes the base message set
	  shared across all MAVLink implementations.

config MAVWRAP_DIALECT_CUSTOM
	bool "obelics"
	help
	  A custom MAVLink dialect. Set MAVWRAP_DIALECT_NAME to the
	  folder name generated by mavgen.

endchoice

endif

# Automatically set for built-in dialects, user-defined for custom
config MAVWRAP_DIALECT_NAME
	string "MAVLink dialect folder name"
	default "common"          if MAVWRAP_DIALECT_COMMON
	default "obelics"                if MAVWRAP_DIALECT_CUSTOM
	help
	  The folder name of the dialect as generated by mavgen.
	  Automatically set for built-in dialects. For custom dialects,
	  set this to the XML filename used to generate the headers.


config LIB_DEMO
    bool "Demo peripherals control"
    default n
    depends on SERVO
    depends on LED_STRIP
    help
        Neopixel LED and ST3215 servo demo animations, exposed through the menu and (optionally) MAVLink.
if LIB_DEMO
config LIB_DEMO_LOG_LEVEL
    int "Demo module log level"
    default 3
    range 0 4
    help
        0=OFF, 1=ERROR, 2=WARNING, 3=INFO, 4=DEBUG
config LIB_DEMO_MAVLINK
    bool "Demo MAVLink command interface"
    default n
    depends on MAVWRAP
    help
        Handle custom OBELICS_DEMO_* MAVLink messages to trigger demos.
endif # LIB_DEMO