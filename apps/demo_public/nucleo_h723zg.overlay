#include <zephyr/dt-bindings/led/led.h>

/ {

};

&spi1 {
    status = "okay";

    led_strip: ws2812_strip@0 {
        status = "okay";
        compatible = "worldsemi,ws2812-spi";

        reg = <0>;
        spi-max-frequency = <DT_FREQ_K(2400)>;
        spi-zero-frame = <4>; // 0b100
        spi-one-frame = <6>; // 0b110
        bits-per-symbol = <3>;

        chain-length = <50>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};
